library(tidyverse)
library(TMB)
library(childSurvLL)

logit <- function(x) return(log(x/(1 - x)))
expit <- function(x) return(exp(x)/(1 + exp(x)))

set.seed(4444)


# setup -------------------------------------------------------------------

# settings
start_year <- 1950
end_year <- 2030
n_years <- length(start_year:end_year)


# data --------------------------------------------------------------------

data_all <- read_csv("MasterMDB_20231207.csv")
data_nn_all <- read_csv("dth0yrDBwide_20231207.csv")

data <- data_all %>%
  filter(whoname == country) %>%
  mutate(x2 = ifelse(is.na(x2), 0, x2),
         x3 = ifelse(is.na(x3), 0, x3),
         x4 = ifelse(is.na(x4), 0, x4)) %>%
  mutate(x1to4 = x1 + x2 + x3 + x4) %>%
  select(iso3, whoname, year, sex, var, x0, x1, x2, x3, x4, x1to4) %>%
  pivot_wider(id_cols = c(iso3, whoname, year, sex), names_from = var, values_from = starts_with("x")) %>%
  group_by(iso3, whoname, year) %>%
  summarise(across(starts_with("x"), sum)) %>% # sum across sex, ignore NA from unknown sex cases
  ungroup() %>%
  mutate(use1to4 = (x1_dth == x1to4_dth | x1_pop == x1to4_pop))
data_igme_method <- data # save here for later

data_nn <- data_nn_all %>%
  filter(whoname == country & sex == "b") %>%
  mutate(xnn_dth = d0 + d1 + d7) %>%
  select(iso3, whoname, year, xnn_dth, births = lb)

data <- left_join(data, data_nn, by = c("iso3", "whoname", "year")) %>%
  mutate(xpnn_dth = x0_dth - xnn_dth,
         xpnn_pop = x0_pop) # for post-neonatal we'll use 1P0 to get first term of the mean

if (any(data$xpnn_dth < 0, na.rm=T)) {
  issue_years <- data[data$xpnn_dth < 0, ]$year
  warning("Removed ", paste(issue_years, collapse = ", "), " because age 0 deaths < neonatal deaths.")
  data <- data %>% filter(!(year %in% issue_years))
}

# if we have neonatal and <1, use neonatal and post-neonatal, otherwise use <1
data$usepnn <- as.logical(!is.na(data$xnn_dth) & !is.na(data$births) & !is.na(data$xpnn_dth))
data[data$usepnn == TRUE,]$x0_dth <- NA
data[data$usepnn == FALSE,]$xpnn_dth <- NA

# if we are using 1to4, drop 1, 2, 3, 4, or else drop 1to4
data[data$use1to4 == TRUE,]$x1_dth <- NA
data[data$use1to4 == TRUE,]$x2_dth <- NA
data[data$use1to4 == TRUE,]$x3_dth <- NA
data[data$use1to4 == TRUE,]$x4_dth <- NA
data[data$use1to4 == FALSE,]$x1to4_dth <- NA

data <- data %>%
  pivot_longer(cols = starts_with("x")) %>%
  mutate(name = gsub("x", "", name)) %>%
  separate(name, into = c("age", "var"), sep = "_") %>%
  pivot_wider(id_cols = c(iso3, whoname, year, age, births), names_from = var) %>%
  rename(deaths = dth) %>%
  filter(!is.na(deaths)) %>%
  mutate(x = ifelse(age == "1to4", 12,
                     ifelse(age == "nn", 0,
                            ifelse(age == "pnn", 1,
                                   12 * as.numeric(age)))),
         n = ifelse(age == "1to4", 48,
                  ifelse(age == "nn", 1,
                         ifelse(age == "pnn", 11, 12))),
         deaths = as.integer(round(deaths)),
         pop = as.integer(round(pop)))

data_vr <- list(
  n_obs_vr = nrow(data), # number of unique observations
  time_id_vr = match(floor(data$year), start_year:end_year), # year ID for each observation
  months_vr = data$x, # beginning of age interval in months for each observation
  obs_vr = data$deaths, # deaths for each observation
  n_vr = data$n, # length of age interval in months for each observation
  births = data$births, # births in the year for each observation
  pop = data$pop # population for each non-neonatal age group, else NA
)

df_pred <- childSurvLL::log_logistic(data_vr, time_model = time_model,
                                     start_year = start_year, end_year = end_year)


# compute using IGME data-prep method -------------------------------------

data_nn$nmr <- data_nn$xnn_dth / data_nn$births

data_igme_method  <- data_igme_method %>%
  mutate(mx_0 = x0_dth / x0_pop,
         mx_1to4 = x1to4_dth / x1to4_pop,
         q0to1 = mx_0 / (1+(1-0.1)*mx_0),
         q1to4 = 4*mx_1to4 / (1+(4-1.6)*mx_1to4),
         q0to5 = 1 - (1-q0to1)*(1-q1to4))


# plot --------------------------------------------------------------------

tmb_results <- df_pred
mle <- read.csv(paste0("results-mle/results/", gsub(" ", "-", country, "_mle2.csv")))
unigme_all <- read.csv("UNIGME-2022.csv")
b3 <- unigme_all %>%
  filter(Geographic.area == country & Series.Name == "UN IGME estimate" &
           Sex == "Total" & Wealth.Quintile == "Total") %>%
  mutate(year = REF_DATE)
unigme <- unigme_all %>%
  filter(Geographic.area == country & Wealth.Quintile == "Total" &
           Sex == "Total" & Series.Name != "UN IGME estimate" &
           Indicator %in% c("Neonatal mortality rate", "Infant mortality rate", "Under-five mortality rate") &
           Observation.Status == "Included in IGME")

# mortality rates
color_pal <- c("MLE LL" = "black", "IGME data prep method" = "plum3",
               "IGME pre-prepped" = "#984EA3", "Smooth LL (TMB)" = "black",
               "B3" = "#984EA3")
shape_pal <- c("MLE LL" = 20, "IGME data prep method" = 17,
               "IGME pre-prepped" = 17)
gg_nmr <- ggplot(data = mle, aes(x = year)) +
  geom_ribbon(data = tmb_results, aes(ymin = nmr_smoothed_lower, ymax = nmr_smoothed_upper,
                                      fill = "Smooth LL (TMB)"), alpha = 0.3) +
  geom_ribbon(data = b3 %>% filter(Indicator == "Neonatal mortality rate"),
              aes(ymin = LOWER_BOUND / 1000, ymax = UPPER_BOUND / 1000,
                  fill = "B3"), alpha = 0.4) +
  geom_point(data = unigme[unigme$Indicator == "Neonatal mortality rate",],
             aes(x = REF_DATE, y = OBS_VALUE/1000, color = "IGME pre-prepped",
                 shape = "IGME pre-prepped")) +
  geom_point(data = data_nn, aes(y = nmr, color = "IGME data prep method",
                                 shape = "IGME data prep method")) +
  geom_point(aes(y = nmr, color = "MLE LL", shape = "MLE LL")) +
  theme_bw() +
  labs(x = "Year", y = "NMR", color = "", shape = "", fill = "") +
  scale_color_manual(values = color_pal) +
