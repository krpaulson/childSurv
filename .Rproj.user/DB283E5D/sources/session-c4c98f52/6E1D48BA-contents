  geom_point(aes(y = imr, color = "MLE LL", shape = "MLE LL")) +
  theme_bw() +
  labs(x = "Year", y = "IMR", color = "", shape = "") +
  scale_color_manual(values = color_pal) +
  scale_shape_manual(values = shape_pal) +
  scale_fill_manual(values = color_pal) +
  scale_y_continuous(limits = c(0, 1.3 * max(mle$imr, na.rm=T)))
gg_u5mr <- ggplot(data = mle, aes(x = year)) +
  geom_ribbon(data = tmb_results, aes(ymin = u5mr_smoothed_lower, ymax = u5mr_smoothed_upper,
