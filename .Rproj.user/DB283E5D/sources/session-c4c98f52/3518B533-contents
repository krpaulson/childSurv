library(tidyverse)
library(TMB)

logit <- function(x) return(log(x/(1 - x)))
expit <- function(x) return(exp(x)/(1 + exp(x)))

set.seed(4444)

# setup -------------------------------------------------------------------

# settings
start_year <- 1950
end_year <- 2030
n_years <- length(start_year:end_year)


# Prep VR estimates from UN-IGME database -----------------------------

unigme <- read.csv("~/Repos/childMort/UNIGME-2022.csv")
vr.ests <- unigme %>%
  filter(Geographic.area == country & Wealth.Quintile == "Total" &
          Sex == "Total" & Series.Name != "UN IGME estimate" &
          Indicator %in% c("Neonatal mortality rate", "Infant mortality rate", "Under-five mortality rate") &
          Observation.Status == "Included in IGME")

if (!all(vr.ests$Series.Category == "VR")) {
  stop("For this script, unique series category should be VR")
}

# convert everything to per-1 from per-1000
vr.ests <- vr.ests %>%
  mutate(OBS_VALUE = OBS_VALUE / 1000,
         STD_ERR = STD_ERR / 1000)

births_wpp <- readxl::read_xlsx("~/Repos/childMort/WPP2022_FERT_F04_BIRTHS_BY_5-YEAR_AGE_GROUPS_OF_MOTHER.xlsx",
                                skip = 16)
births_wpp <- births_wpp %>%
  filter(str_detect(`Region, subregion, country or area *`, country)) %>%
  select(year_merge = Year, `10-14`, `15-19`, `20-24`, `25-29`, `30-34`, `35-39`, `40-44`, `45-49`, `50-54`) %>%
  pivot_longer(cols = !year_merge) %>%
  group_by(year_merge) %>%
  summarise(births_wpp = sum(as.numeric(value) * 1000)) %>%
  ungroup()
vr.ests$year_merge <- floor(vr.ests$REF_DATE)
vr.ests <- merge(vr.ests, births_wpp, by = "year_merge", all.x = T)

# standard error (overdispersed Poisson)
sigma <- sqrt(8.260953e-05)
vr.ests <- vr.ests %>%
  mutate(STD_ERR = 
           (births_wpp)^{-1/2}*sqrt(OBS_VALUE)*
           sqrt((births_wpp)*OBS_VALUE*(exp(sigma^2)-1)*exp(sigma^2)+exp(sigma^2/2))) %>%
  select(Indicator, Series.Category, year = REF_DATE, se = STD_ERR, qx = OBS_VALUE) %>%
  mutate(logit_qx = logit(qx),
         logit_se = (1/(qx - qx^2))*se) # delta method

n_obs_vr <- nrow(vr.ests)
time_id_vr <- match(floor(vr.ests$year), start_year:end_year)
months_vr <- sapply(vr.ests$Indicator, switch,
                 "Neonatal mortality rate" = 1,
                 "Infant mortality rate" = 12,
                 "Under-five mortality rate" = 60) %>% unname()
obs_vr <- vr.ests$logit_qx
se_vr <- vr.ests$logit_se

# check our time period covers the vr estimates
assertthat::assert_that(
  !anyNA(time_id_vr),
  msg = "start_year:end_year doesn't cover all vr estimates."
)

# TMB ---------------------------------------------------------------------

if (temporal_model == "spline") {
  
  # B spline
  # place knot at xr and every dx years before and after
  bspline <- function(x) {
    xl <- min(x) - 10
    xr <- max(x) + 10
    dx <- 2.5
    bdeg <- 3
    knots <- -1*rev(seq(-1*(xr + bdeg * dx), -1*(xl - bdeg * dx), by = dx))
    B <- splines::spline.des(knots, x, bdeg + 1, 0 * x, outer.ok = TRUE)$design
    return(B)
  }
  B <- bspline(1:n_years)
  n_betas <- ncol(B)
  
  # Constraint matrix
  A <- matrix(1, nrow=1, ncol=n_betas)
  
  # RW2 structure matrix
  inla.rw = utils::getFromNamespace("inla.rw", "INLA")
  R <- inla.rw(n_betas, order = 2, sparse = T, scale.model = T)
  R <- R + diag(n_betas) * 1e-6
  
  # load TMB model
  TMB::compile("tmbModelLLsplineonlyVR.cpp", flags = "-w")
  dyn.load(TMB::dynlib("tmbModelLLsplineonlyVR"))
  
  # define negative log-likelihood x prior
  obj <- TMB::MakeADFun(
    data = list(B = B,
                A = A,
                R = R,
                n_obs_vr = n_obs_vr,
                time_id_vr = time_id_vr,
                months_vr = months_vr,
                obs_vr = obs_vr,
                se_vr = se_vr),
    parameters = list(intercept_log_shape = 0,
                      intercept_log_scale = 0,
                      log_tau_delta_log_shape = 0,
                      log_tau_delta_log_scale = 0,
                      delta_log_shape = rep(0, n_betas),
                      delta_log_scale = rep(0, n_betas)),
    random = c("delta_log_shape", "delta_log_scale"),
    map = list(),
    hessian = TRUE,
    DLL = "tmbModelLLsplineonlyVR"
  )
} else if(temporal_model == "rw2") {
  
  # RW2 structure matrix
  inla.rw = utils::getFromNamespace("inla.rw", "INLA")
  R <- inla.rw(n_years, order = 2, sparse = T, scale.model = T)
  R <- R + diag(n_years) * 1e-6
  
  # load TMB model
  TMB::compile("tmbModelLLrw2onlyVR.cpp", flags = "-w")
  dyn.load(TMB::dynlib("tmbModelLLrw2onlyVR"))
  
  # define negative log-likelihood x prior
  obj <- TMB::MakeADFun(
    data = list(n_years = n_years,
                R = R,
                n_obs_vr = n_obs_vr,
                time_id_vr = time_id_vr,
                months_vr = months_vr,
                obs_vr = obs_vr,
                se_vr = se_vr),
    parameters = list(intercept_log_shape = 0,
                      intercept_log_scale = 0,
                      log_tau_delta_log_shape = 0,
                      log_tau_delta_log_scale = 0,
                      log_tau_epsilon_log_shape = 0,
                      log_tau_epsilon_log_scale = 0,
                      delta_log_shape = rep(0, n_years),
                      delta_log_scale = rep(0, n_years),
                      epsilon_log_shape = rep(0, n_years),
                      epsilon_log_scale = rep(0, n_years)),
    random = c("delta_log_shape", "delta_log_scale",
               "epsilon_log_shape", "epsilon_log_scale"),
    map = list(),
    hessian = TRUE,
    DLL = "tmbModelLLrw2onlyVR"
  )
} else {
  stop("Invalid temporal model.")
}


# optimize
opt <- nlminb(obj$par, obj$fn, obj$gr,
              lower     = rep(-60, length(obj$par)),
              upper     = rep(600, length(obj$par)))
SD0 <- TMB::sdreport(obj,
                     getJointPrecision = TRUE,
                     getReportCovariance = TRUE,
                     bias.correct = TRUE,
                     bias.correct.control = list(sd = TRUE))


# TMB post-processing ------------------------------------------------------

# obtain point estimates (means) for fixed and random effects
mu <- c(SD0$par.fixed, SD0$par.random)

# get ids for different parameters
intercept.shape.idx <- which(names(mu) == "intercept_log_shape")
intercept.scale.idx <- which(names(mu) == "intercept_log_scale")
time.struct.shape.idx <- which(names(mu) == "delta_log_shape")
time.struct.scale.idx <- which(names(mu) == "delta_log_scale")

if (temporal_model == "spline") {
  
  # create list of constraint matrices for these terms
  A.mat.list <- list()
  A.mat.list[[1]] <- matrix(1, nrow = 1, ncol = n_betas)
  A.mat.list[[2]] <- matrix(1, nrow = 1, ncol = n_betas)
  
  # sample
  # Reference: https://github.com/taylorokonek/stbench/blob/main/R/multiconstr_prec.R
  multiconstr_prec = utils::getFromNamespace("multiconstr_prec", "stbench")
  t.draws <- multiconstr_prec(mu = mu,
                              prec = SD0$jointPrecision,
                              n.sims = 1000,
                              constrain.idx.list = list(time.struct.shape.idx,
                                                        time.struct.scale.idx),
                              A.mat.list = A.mat.list)
  
  # take the constrained draws
  t.draws <- t.draws$x.c
  
  # combine draws for linear predictor (log shape)
  fitted_beta_shape <-
    matrix(rep(t.draws[intercept.shape.idx,], n_betas), nrow = n_betas, byrow = T) +
    t.draws[time.struct.shape.idx,]
  fitted_shape <- B %*% fitted_beta_shape
  
  # combine draws for linear predictor (log scale)
  fitted_beta_scale <-
    matrix(rep(t.draws[intercept.scale.idx,], n_betas), nrow = n_betas, byrow = T) +
    t.draws[time.struct.scale.idx,]
  fitted_scale <- B %*% fitted_beta_scale
  
} else if(temporal_model == "rw2") {
  
  # create list of constraint matrices for these terms
  A.mat.list <- list()
  A.mat.list[[1]] <- matrix(1, nrow = 1, ncol = n_years)
  A.mat.list[[2]] <- matrix(1, nrow = 1, ncol = n_years)
  
  # sample
  # Reference: https://github.com/taylorokonek/stbench/blob/main/R/multiconstr_prec.R
  multiconstr_prec = utils::getFromNamespace("multiconstr_prec", "stbench")
  t.draws <- multiconstr_prec(mu = mu,
                              prec = SD0$jointPrecision,
                              n.sims = 1000,
                              constrain.idx.list = list(time.struct.shape.idx,
                                                        time.struct.scale.idx),
                              A.mat.list = A.mat.list)
  
  # take the constrained draws
  t.draws <- t.draws$x.c
  
  # combine draws for linear predictor (log shape)
  fitted_shape <-
    matrix(rep(t.draws[intercept.shape.idx,], n_years), nrow = n_years, byrow = T) +
    #t.draws[time.unstruct.shape.idx,] +
    t.draws[time.struct.shape.idx,]
  
  # combine draws for linear predictor (log scale)
  fitted_scale <-
    matrix(rep(t.draws[intercept.scale.idx,], n_years), nrow = n_years, byrow = T) +
    #t.draws[time.unstruct.scale.idx,] +
    t.draws[time.struct.scale.idx,]
  
} else {
  stop("Invalid temporal model.")
}


# combine to get nmr, imr, u5mr
nmr_mat <- matrix(nrow = n_years, ncol = 1000)
imr_mat <- matrix(nrow = n_years, ncol = 1000)
u5mr_mat <- matrix(nrow = n_years, ncol = 1000)
for (t in 1:n_years) {
  nmr_mat[t,] <- flexsurv::pllogis(1, exp(fitted_shape)[t,], exp(fitted_scale)[t,])
  imr_mat[t,] <- flexsurv::pllogis(12, exp(fitted_shape)[t,], exp(fitted_scale)[t,])
  u5mr_mat[t,] <- flexsurv::pllogis(60, exp(fitted_shape)[t,], exp(fitted_scale)[t,])
}

#  create prediction data.frame
df_pred <- data.frame(year = start_year:end_year)

# get summaries
df_pred$log_shape_smoothed_med <- apply(fitted_shape, 1, quantile, 0.5)
df_pred$log_shape_smoothed_lower <- apply(fitted_shape, 1, quantile, 0.05)
df_pred$log_shape_smoothed_upper <- apply(fitted_shape, 1, quantile, 0.95)
df_pred$log_scale_smoothed_med <- apply(fitted_scale, 1, quantile, 0.5)
df_pred$log_scale_smoothed_lower <- apply(fitted_scale, 1, quantile, 0.05)
df_pred$log_scale_smoothed_upper <- apply(fitted_scale, 1, quantile, 0.95)
df_pred$nmr_smoothed_med <- apply(nmr_mat, 1, quantile, 0.5)
df_pred$nmr_smoothed_lower <- apply(nmr_mat, 1, quantile, 0.05)
df_pred$nmr_smoothed_upper <- apply(nmr_mat, 1, quantile, 0.95)
df_pred$imr_smoothed_med <- apply(imr_mat, 1, quantile, 0.5)
df_pred$imr_smoothed_lower <- apply(imr_mat, 1, quantile, 0.05)
df_pred$imr_smoothed_upper <- apply(imr_mat, 1, quantile, 0.95)
df_pred$u5mr_smoothed_med <- apply(u5mr_mat, 1, quantile, 0.5)
