
library(tidyverse)

# Andorra: too many zeros
# Anguilla
# Monaco
# San Marino
# United Kingdom

countries <- c('Antigua and Barbuda' , 'Argentina' , 'Australia' ,
               'Austria' , 'Bahamas' , 'Barbados' , 'Belarus' , 'Belgium' , 'Bosnia and Herzegovina' ,
               'British Virgin Islands' , 'Bulgaria' , 'Canada' , 'Chile' , 'Croatia' , 'Cuba' ,
               'Cyprus' , 'Czechia' , 'Denmark' , 'Dominica' , 'Estonia' , 'Finland' , 'France' ,
               'Germany' , 'Greece' , 'Grenada' , 'Hungary' , 'Iceland' , 'Ireland' , 'Israel' ,
               'Italy' , 'Japan' , 'Latvia' , 'Lithuania' , 'Luxembourg' , 'Malta' , 'Mauritius' ,
               'Montenegro' , 'Netherlands' , 'New Zealand' , 'North Macedonia' ,
               'Norway' , 'Poland' , 'Portugal' , 'Romania' , 'Saint Kitts and Nevis' , 'Saint Lucia' ,
               'Saint Vincent and the Grenadines' , 'Serbia' , 'Singapore' ,
               'Slovakia' , 'Slovenia' , 'Spain' , 'Sweden' , 'Switzerland' ,
               'United States of America')

data_all <- read_csv("MasterMDB_20231207.csv")
data_nn_all <- read_csv("dth0yrDBwide_20231207.csv")
unigme_all <- read.csv("UNIGME-2022.csv")

for (country in countries) {
  print(country)
  
  # Data --------------------------------------------------------------------
  
  data <- data_all %>%
    filter(whoname == country) %>%
    mutate(x2 = ifelse(is.na(x2), 0, x2),
           x3 = ifelse(is.na(x3), 0, x3),
           x4 = ifelse(is.na(x4), 0, x4)) %>%
    mutate(x1to4 = x1 + x2 + x3 + x4) %>%
    select(iso3, whoname, year, sex, var, x0, x1, x2, x3, x4, x1to4) %>%
    pivot_longer(cols = c(x0, x1, x2, x3, x4, x1to4), names_to = "age") %>%
    group_by(iso3, whoname, year, var, age) %>%
    summarise(value = sum(value, na.rm=T)) %>% # sum across sex, ignore NA from unknown sex cases
    ungroup() %>%
    pivot_wider(id_cols = c(iso3, whoname, year, age), names_from = var) %>%
    rename(deaths = dth) %>%
    mutate(x = as.numeric(substr(age, 2, 2)) * 12,
           n = ifelse(age == "x1to4", 48, 12),
           deaths = as.integer(round(deaths)),
           pop = as.integer(round(pop)))
  
  data_nn <- data_nn_all %>%
    filter(whoname == country & sex == "b") %>%
    mutate(deaths_nn = d0 + d1 + d7) %>%
    select(iso3, whoname, year, deaths_nn, births = lb)
  
  unigme <- unigme_all %>%
    filter(Geographic.area == country & Wealth.Quintile == "Total" &
             Sex == "Total" & Series.Name != "UN IGME estimate" &
             Indicator %in% c("Neonatal mortality rate", "Infant mortality rate", "Under-five mortality rate") &
             Observation.Status == "Included in IGME")
  
  # results from TMB model
  spline_file <- paste0("results/VR_only/", gsub(" ", "-", country), "_spline.csv")
  rw_file <- paste0("results/VR_only/", gsub(" ", "-", country), "_rw2.csv")
  if (file.exists(spline_file)) {
    tmb_results <- read.csv(spline_file)
  } else {
    warning(paste0("Using rw2 for ", country, " because no spline fit exists."))
    tmb_results <- read.csv(rw_file)
  }
  
  
  # Likelihood --------------------------------------------------------------
  
  # survival function
  s <- function(x, log_shape, log_scale) {
    return(1/(1+(x/exp(log_scale))^(exp(log_shape))))
  }
  
  # mortality rate (nmx)
  mx <- function(x, n, log_shape, log_scale) {
    ndx <- s(x, log_shape, log_scale) - s(x+n, log_shape, log_scale)
    nLx <- stats::integrate(s, x, x+n, log_shape = log_shape, log_scale = log_scale)$value
    nLx <- nLx / 12 # convert person-months to person-years
    return(ndx/nLx)
  }
  
  # negative log-likelihood
  nll <- function(theta = c(log_shape, log_scale), pop, deaths, x, n, deaths_nn = NULL, births = NULL) {
    nll_result <- 0
    # 0, 1, 2, 3, 4 OR <1 and 1-4 if single-year not available
    # if using neonatal deaths, need to use post-neonatal instead of <1 to get independent age groups
    for (i in 1:length(deaths)) {
      if (!is.null(deaths_nn) & x[i] == 0) {
        lambda <- pop[i] * mx(x[i], n[i], log_shape = theta[1], log_scale = theta[2]) -
          (1-s(1, log_shape = theta[1], log_scale = theta[2]))*births
        deaths_i <- deaths[i] - deaths_nn
      } else {
        lambda <- pop[i] * mx(x[i], n[i], log_shape = theta[1], log_scale = theta[2])
        deaths_i <- deaths[i]
      }
      nll_result <- nll_result - dpois(deaths_i, lambda = lambda, log = T)
    }
    # neonatal deaths
    if (!is.null(deaths_nn)) {
      qnn <- 1 - s(1, log_shape = theta[1], log_scale = theta[2])
      #lambda <- births * qnn
      #nll_result <- nll_result - dpois(deaths_nn, lambda = lambda, log = T)
      nll_result <- nll_result - dbinom(deaths_nn, size = births, prob = qnn, log = T)
    }
    return(nll_result)
  }
  
  # Maximize ----------------------------------------------------------------
  
  results <- list()
  for (yy in unique(data$year)) {

    # subset data
    tmp <- data[data$year == yy,]
    if (all(is.na(tmp$deaths)) | all(is.na(tmp$pop))) {
      warning(paste0("Missing deaths or pop for ", yy))
      next()
    }
    deaths234 <- tmp[tmp$x >= 24, "deaths"]
    pop234 <- tmp[tmp$x >= 24, "pop"]
    if (all(deaths234 == 0) | all(pop234 == 0)) {
      tmp <- tmp[tmp$age == "x0" | tmp$age == "x1to4",]
    } else {
      tmp <- tmp[tmp$age != "x1to4",]
    }
    if (all(tmp$deaths == 0) | all(tmp$pop == 0)) {
      warning(paste0("Missing deaths or pop for ", yy))
      next()
    }
    
    # subset data neonatal
    # plus data check for nn deaths < 0to1 deaths
    tmp_nn <- data_nn[data_nn$year == yy,]
    if (nrow(tmp_nn) > 0) {
      deaths_nn <- tmp_nn$deaths_nn
      births <- tmp_nn$births
      if (is.na(deaths_nn) | is.na(births) |
          tmp[tmp$age == "x0",]$deaths <= deaths_nn) {
        deaths_nn <- NULL
        births <- NULL
      }
    } else {
      deaths_nn <- NULL
      births <- NULL
    }
    
    # must have >0 deaths for 1to4
    if (sum(deaths234) == 0 & 
        data[data$year == yy & data$age == "x1to4",]$deaths == 0) {
      warning(paste0("Zero deaths for 1 to 4 ", yy))
      next()
    }
    
    # get MLE
    res <- optim(c(-2, 100), nll, pop = tmp$pop, deaths = tmp$deaths,
                 x = tmp$x, n = tmp$n, deaths_nn = deaths_nn,
                 births = births, hessian = T)
    invI <- solve(res$hessian)
    results[[paste(yy)]] <- data.frame(
      year = yy, 
      log_shape_mle = res$par[1],
      log_scale_mle = res$par[2],
      se_log_shape_mle = sqrt(diag(invI))[1],
      se_log_scale_mle = sqrt(diag(invI))[2]
    )
    
  }
  results <- do.call(rbind, results)
  
  
  # compute using IGME data-prep method -------------------------------------
  
  data_nn$nmr <- data_nn$deaths_nn / data_nn$births
  
  data_wide <- data %>%
    filter(age == "x0" | age == "x1to4") %>%
    mutate(nMx = deaths / pop) %>%
    select(year, age, nMx) %>%
    pivot_wider(id_cols = c(year), names_from = age, values_from = nMx) %>%
    mutate(q0to1 = x0 / (1+(1-0.1)*x0),
           q1to4 = 4*x1to4 / (1+(4-1.6)*x1to4),
           q0to5 = 1 - (1-q0to1)*(1-q1to4))
  
  
  # summarize results -------------------------------------------------------
  
  results$nmr <- flexsurv::pllogis(1, exp(results$log_shape_mle), exp(results$log_scale_mle))
  results$imr <- flexsurv::pllogis(12, exp(results$log_shape_mle), exp(results$log_scale_mle))
  results$u5mr <- flexsurv::pllogis(60, exp(results$log_shape_mle), exp(results$log_scale_mle))
  
  #results$nmr2 <- 1-s(1, results$log_shape_mle, results$log_scale_mle)
  #results$imr2 <- 1-s(12, results$log_shape_mle, results$log_scale_mle)
  #results$u5mr2 <- 1-s(60, results$log_shape_mle, results$log_scale_mle)
  
  b3 <- unigme_all %>%
    filter(Geographic.area == country & Series.Name == "UN IGME estimate" &
             Sex == "Total" & Wealth.Quintile == "Total") %>%
    mutate(year = REF_DATE)
  
  # parameters
  gg_shape <- ggplot(data = results, aes(x = year)) +
    geom_point(aes(y = log_shape_mle)) +
    geom_errorbar(aes(ymin = log_shape_mle - 1.96*se_log_shape_mle,
                      ymax = log_shape_mle + 1.96*se_log_shape_mle),
                  width = 0) +
    theme_bw() +
    labs(x = "Year", y = "log shape")
  gg_scale <- ggplot(data = results, aes(x = year)) +
    geom_point(aes(y = log_scale_mle)) +
    geom_errorbar(aes(ymin = log_scale_mle - 1.96*se_log_scale_mle,
                      ymax = log_scale_mle + 1.96*se_log_scale_mle),
                  width = 0) +
    theme_bw() +
    labs(x = "Year", y = "log scale")
  
  # mortality rates
  color_pal <- c("MLE" = "blue", "IGME data prep method" = "plum3",
                 "IGME pre-prepped" = "#984EA3", "Smoothed IGME (TMB)" = "black",
                 "B3" = "#984EA3")
  shape_pal <- c("MLE" = 19, "IGME data prep method" = 17,
                 "IGME pre-prepped" = 17)
  gg_nmr <- ggplot(data = results, aes(x = year)) +
    geom_ribbon(data = tmb_results, aes(ymin = nmr_smoothed_lower, ymax = nmr_smoothed_upper,
                                        fill = "Smoothed IGME (TMB)"), alpha = 0.3) +
    geom_ribbon(data = b3 %>% filter(Indicator == "Neonatal mortality rate"),
                aes(ymin = LOWER_BOUND / 1000, ymax = UPPER_BOUND / 1000,
                    fill = "B3"), alpha = 0.3) +
    geom_point(data = unigme[unigme$Indicator == "Neonatal mortality rate",],
               aes(x = REF_DATE, y = OBS_VALUE/1000, color = "IGME pre-prepped",
                   shape = "IGME pre-prepped")) +
    geom_point(data = data_nn, aes(y = nmr, color = "IGME data prep method",
                                   shape = "IGME data prep method")) +
    geom_point(aes(y = nmr, color = "MLE", shape = "MLE")) +
    theme_bw() +
    labs(x = "Year", y = "NMR", color = "", shape = "", fill = "") +
    scale_color_manual(values = color_pal) +
    scale_shape_manual(values = shape_pal) +
    scale_fill_manual(values = color_pal) +
    scale_y_continuous(limits = c(0, 1.3 * max(c(results$nmr, data_nn$nmr), na.rm=T)))
  gg_imr <- ggplot(data = results, aes(x = year)) +
    geom_ribbon(data = tmb_results, aes(ymin = imr_smoothed_lower, ymax = imr_smoothed_upper,
                                        fill = "Smoothed IGME (TMB)"), alpha = 0.3) +
    geom_ribbon(data = b3 %>% filter(Indicator == "Infant mortality rate"),
                aes(ymin = LOWER_BOUND / 1000, ymax = UPPER_BOUND / 1000,
                    fill = "B3"), alpha = 0.3) +
    geom_point(data = unigme[unigme$Indicator == "Infant mortality rate",],
               aes(x = REF_DATE, y = OBS_VALUE/1000, color = "IGME pre-prepped",
                   shape = "IGME pre-prepped")) +
    geom_point(data = data_wide, aes(y = q0to1, color = "IGME data prep method",
                                     shape = "IGME data prep method")) +
    geom_point(aes(y = imr, color = "MLE", shape = "MLE")) +
    theme_bw() +
    labs(x = "Year", y = "IMR", color = "", shape = "") +
    scale_color_manual(values = color_pal) +
    scale_shape_manual(values = shape_pal) +
    scale_fill_manual(values = color_pal) +
    scale_y_continuous(limits = c(0, 1.3 * max(c(results$imr, data_wide$q0to1), na.rm=T)))
  gg_u5mr <- ggplot(data = results, aes(x = year)) +
    geom_ribbon(data = tmb_results, aes(ymin = u5mr_smoothed_lower, ymax = u5mr_smoothed_upper,
                                        fill = "Smoothed IGME (TMB)"), alpha = 0.3) +
    geom_ribbon(data = b3 %>% filter(Indicator == "Under-five mortality rate"),
                aes(ymin = LOWER_BOUND / 1000, ymax = UPPER_BOUND / 1000,
                    fill = "B3"), alpha = 0.3) +
    geom_point(data = unigme[unigme$Indicator == "Under-five mortality rate",],
               aes(x = REF_DATE, y = OBS_VALUE/1000, color = "IGME pre-prepped",
                   shape = "IGME pre-prepped")) +
    geom_point(data = data_wide, aes(y = q0to5, color = "IGME data prep method",
                                     shape = "IGME data prep method")) +
    geom_point(aes(y = u5mr, color = "MLE", shape = "MLE")) +
    theme_bw() +
    labs(x = "Year", y = "U5MR", color = "", shape = "") +
    scale_color_manual(values = color_pal) +
    scale_shape_manual(values = shape_pal) +
    scale_fill_manual(values = color_pal) +
    scale_y_continuous(limits = c(0, 1.3 * max(c(results$u5mr, data_wide$q0to5), na.rm = T)))
  
  gg_mrs <- ggpubr::ggarrange(gg_nmr, gg_imr, gg_u5mr, common.legend = T, nrow = 1)
  gg_mrs <- ggpubr::annotate_figure(gg_mrs, top = country)
  
  pdf(paste0("results-mle/plots/", gsub(" ", "-", country), ".pdf"), width = 15, height = 6)
  print(gg_mrs)
  dev.off()
  
  results$country <- country
  readr::write_csv(results, file = paste0("results-mle/results/", gsub(" ", "-", country, "_mle2.csv")))
  
}

